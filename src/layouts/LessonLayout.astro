---
import "@/styles/global.css"
import { Header } from "@/components/Header"
import { Footer } from "@/components/Footer"

const { title = "Iteracja vs Rekurencja" } = Astro.props
const currentPath = Astro.url.pathname
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/iter_recur/favicon.svg" />
    <script is:inline>
      (function() {
        const stored = localStorage.getItem("theme");
        if (stored === "dark" || (!stored && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
    <title>{title}</title>
  </head>
  <body class="max-w-[100vw] bg-background text-foreground min-h-screen overflow-x-hidden">
    <div class="fixed inset-0 z-[-1] bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-background via-background to-background"></div>
    
    <Header client:load currentPath={currentPath} />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
