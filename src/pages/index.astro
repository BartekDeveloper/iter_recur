              <RiCheckboxCircleLine className="size-7 text-teal-500" />
            </div>
            <div>
              <h3 className="text-xl font-bold text-teal-500 mb-3">6. Sledzenie glebokosci wywolan</h3>
              <p className="text-muted-foreground mb-3">Monitoruj aktualna glebokosc rekurencji w czasie rzeczywistym:</p>
              <CodeBlock code={`static int currentDepth = 0;
static int maxRecordedDepth = 0;

public static void trackedRecursion(int n) {
    currentDepth++;
    maxRecordedDepth = Math.max(maxRecordedDepth, currentDepth);
    if (n <= 0) { currentDepth--; return; }
    trackedRecursion(n - 1);
    currentDepth--;
}`} lang="java" />
            </div>
          </div>
        </InfoBox>

        <InfoBox borderColor="border-teal-500/40 bg-teal-500/5">
