---
import LessonLayout from "@/layouts/LessonLayout.astro"
import { Section, InfoBox } from "@/components/Section"
import CodeBlock from "@/components/CodeBlock.astro"
import {
  RiRefreshLine,
  RiFunctionLine,
  RiAlertLine,
  RiLightbulbLine,
  RiArrowRightSLine,
  RiCheckboxCircleLine,
  RiCloseCircleLine,
  RiBrainLine,
  RiGitBranchLine,
  RiFileChartLine,
  RiCheckLine,
  RiCloseLine,
  RiFlaskLine,
} from "@remixicon/react"
---

<LessonLayout title="Iteracja vs Rekurencja - Teoria">
  <div class="max-w-4xl mx-auto px-6 py-10 space-y-16">
    <!-- Wprowadzenie -->
    <div class="text-center space-y-4 pb-8 border-b border-border">
      <h1 class="text-4xl font-bold text-foreground">Iteracja vs Rekurencja</h1>
      <p class="text-xl text-muted-foreground">Dwa fundamentalne podejscia do rozwiazywania problemow w programowaniu</p>
    </div>

    <Section title="Wprowadzenie" titleColor="text-primary">
      <div class="prose prose-lg max-w-none">
        <p class="text-lg text-foreground/90 leading-relaxed">
          <span class="font-semibold text-primary">Iteracja</span> i <span class="font-semibold text-purple-500">rekurencja</span> to dwa rozne sposoby powtarzania dzialan w programowaniu.
        </p>
        <p class="text-lg text-foreground/80 leading-relaxed mt-4">
          Obie techniki sluza do rozwiazywania problemow, ale dzialaja w <span class="font-semibold">calkowicie inny sposob</span>. Poznaj ich zalety i wady!
        </p>
      </div>
      <InfoBox borderColor="border-primary/40 bg-primary/5">
        <div class="grid md:grid-cols-2 gap-6">
          <div class="flex items-start gap-4">
            <div class="p-3 bg-primary/10 rounded-lg">
              <RiRefreshLine className="size-8 text-primary" />
            </div>
            <div>
              <h4 class="font-bold text-primary text-lg">Iteracja</h4>
              <p class="text-muted-foreground text-sm mt-1">Powtarzanie za pomoca petli (for, while, do-while)</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="p-3 bg-purple-500/10 rounded-lg">
              <RiFunctionLine className="size-8 text-purple-500" />
            </div>
            <div>
              <h4 class="font-bold text-purple-500 text-lg">Rekurencja</h4>
              <p class="text-muted-foreground text-sm mt-1">Funkcja wywoluje sama siebie</p>
            </div>
          </div>
        </div>
      </InfoBox>
    </Section>

    <!-- 1. Czym jest Iteracja -->
    <Section title="1. Czym jest Iteracja?" titleColor="text-primary">
      <div class="bg-blue-500/5 border-l-4 border-blue-500 p-4 rounded-r-lg mb-6">
        <p class="text-lg text-foreground/90 leading-relaxed">
          <span class="font-semibold text-blue-500">Iteracja</span> uzera petli do wykonywania kodu wielokrotnie, dopoki warunek jest spelniony.
        </p>
        <p class="text-base text-muted-foreground mt-3">
          Program pozostaje w tym samym "miejscu" w pamieci — dlatego iteracja jest zazwyczaj <span class="font-semibold text-green-500">szybsza</span> i zużywa <span class="font-semibold text-green-500">mniej pamieci</span>.
        </p>
      </div>

      <h3 class="text-xl font-semibold text-foreground mb-4 flex items-center gap-3">
        <span class="w-8 h-8 bg-primary/10 rounded-full flex items-center justify-center text-primary text-sm">1</span>
        Przyklad: Odliczanie za pomoca petli
      </h3>
      <CodeBlock code={`public class Main {
    public static void main(String[] args) {
        countdownIteration(5);
    }
    
    public static void countdownIteration(int n) {
        while (n > 0) {
            System.out.println(n);
            n--;
        }
    }
}`} lang="java" />

      <div class="mt-6">
        <h4 class="text-lg font-semibold text-foreground mb-3">Jak to dziala?</h4>
        <p class="text-muted-foreground mb-3">Dla <span class="font-mono text-primary font-semibold">n = 5</span>:</p>
        <InfoBox borderColor="border-green-500/30 bg-green-500/5">
          <div class="font-mono text-base text-foreground space-y-1">
            <div>n = 5, drukuj 5, n--</div>
            <div>n = 4, drukuj 4, n--</div>
            <div>n = 3, drukuj 3, n--</div>
            <div>n = 2, drukuj 2, n--</div>
            <div>n = 1, drukuj 1, n--</div>
            <div class="text-red-400">n = 0, warunek FALSZ, koniec</div>
          </div>
        </InfoBox>
      </div>
    </Section>

    <!-- 2. Czym jest Rekurencja -->
    <Section title="2. Czym jest Rekurencja?" titleColor="text-purple-500">
      <div class="bg-purple-500/5 border-l-4 border-purple-500 p-4 rounded-r-lg mb-6">
        <p class="text-lg text-foreground/90">
          <span class="font-semibold text-purple-500">Rekurencja</span> wystepuje wtedy, gdy funkcja wywoluje sama siebie.
        </p>
      </div>
      
      <p class="text-lg text-foreground/80 mb-6">
        Kazda funkcja rekurencyjna musi miec <span class="font-bold text-foreground">dwa kluczowe elementy</span>:
      </p>

      <div class="grid md:grid-cols-2 gap-6 mb-6">
        <InfoBox borderColor="border-green-500/40 bg-green-500/5">
          <div class="flex">
            <div class="w-10 flex-shrink-0">
              <RiLightbulbLine className="size-7 text-green-500" />
            </div>
            <div>
              <h3 className="text-lg font-bold text-green-500 mb-2">Przypadek Bazowy</h3>
              <p className="text-muted-foreground text-sm">Warunek zatrzymania. Bez niego funkcja dzialalaby w nieskonczonosc!</p>
            </div>
          </div>
        </InfoBox>
        <InfoBox borderColor="border-blue-500/40 bg-blue-500/5">
          <div class="flex">
            <div class="w-10 flex-shrink-0">
              <RiRefreshLine className="size-7 text-blue-500" />
            </div>
            <div>
              <h3 className="text-lg font-bold text-blue-500 mb-2">Krok Rekurencyjny</h3>
              <p className="text-muted-foreground text-sm">Funkcja wywoluje sama siebie z mniejszym lub prostszym problemem.</p>
            </div>
          </div>
        </InfoBox>
      </div>

      <h3 class="text-xl font-semibold text-foreground mb-4 flex items-center gap-3">
        <span class="w-8 h-8 bg-purple-500/10 rounded-full flex items-center justify-center text-purple-500 text-sm">2</span>
        Przyklad: Odliczanie z Rekurencja
      </h3>
      <CodeBlock code={`public class Main {
    public static void main(String[] args) {
        countdownRecursion(5);
    }
    
    public static void countdownRecursion(int n) {
        if (n <= 0) return;
        System.out.println(n);
        countdownRecursion(n - 1);
    }
}`} lang="java" />
    </Section>

    <!-- 3. Stos Wywolan -->
    <Section title="3. Stos Wywolan (Call Stack)" titleColor="text-orange-500">
      <div class="bg-orange-500/5 border-l-4 border-orange-500 p-4 rounded-r-lg mb-6">
        <p class="text-lg text-foreground/90">
          Podczas rekurencji komputer musi <span class="font-semibold text-orange-500">pamietac kazde wywolanie funkcji</span>.
        </p>
      </div>
      
      <p class="text-base text-foreground/80 leading-relaxed mb-6">
        Mozna to porownac do <span class="font-semibold text-foreground">ukladania ksiazek na stosie</span> — jedno wywolanie trafia na gore, potem kolejne.
      </p>
      
      <InfoBox borderColor="border-red-500/40 bg-red-500/5">
        <div class="flex">
          <div class="w-10 flex-shrink-0">
            <RiAlertLine className="size-7 text-red-500" />
          </div>
          <div>
            <h3 className="text-xl font-bold text-red-500 mb-2">Stack Overflow</h3>
            <p className="text-muted-foreground">
              Jesli wywolan bedzie zbyt duzo, program moze sie zatrzymac z bledem <span class="font-mono text-red-400">StackOverflowError</span>.
              Iteracja zazwyczaj nie ma tego problemu.
            </p>
          </div>
        </div>
      </InfoBox>
    </Section>

    <!-- 4. Modele Myslenia -->
    <Section title="4. Modele Myslenia" titleColor="text-yellow-500">
      <p class="text-lg text-foreground/80 mb-6">
        Poznaj intuicyjne skojarzenia, ktore pomoga Ci zapamietac roznic:
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        <InfoBox borderColor="border-blue-500/40 bg-blue-500/5">
          <div class="flex">
            <div class="w-10 flex-shrink-0">
              <RiRefreshLine className="size-7 text-blue-500" />
            </div>
            <div>
              <h3 className="text-lg font-bold text-blue-500 mb-3">Iteracja = Bieznia</h3>
              <p className="text-muted-foreground mb-3">Powtarzasz kroki, dopoki warunek nie powie "stop".</p>
              <div className="font-mono text-sm text-muted-foreground bg-muted p-2 rounded">
                krok -> sprawdzenie -> krok -> sprawdzenie
              </div>
            </div>
          </div>
        </InfoBox>
        <InfoBox borderColor="border-purple-500/40 bg-purple-500/5">
          <div class="flex">
            <div class="w-10 flex-shrink-0">
              <RiFunctionLine className="size-7 text-purple-500" />
            </div>
            <div>
              <h3 className="text-lg font-bold text-purple-500 mb-3">Rekurencja = Matrioszki</h3>
              <p className="text-muted-foreground">Otwierasz jedna lalke, potem kolejna mniejsza, potem nastepna...</p>
              <p className="text-muted-foreground mt-2">Na koniec dochodzisz do najmniejszej lalki (przypadek bazowy), a potem wracasz z powrotem.</p>
            </div>
          </div>
        </InfoBox>
      </div>
    </Section>

    <!-- 5. Przyklad — Silnia -->
    <Section title="5. Przyklad — Silnia" titleColor="text-cyan-500">
      <p class="text-lg text-muted-foreground mb-6">
        Silnia to iloczyn wszystkich liczb naturalnych od 1 do n:
        <span class="font-mono ml-2">5! = 5 x 4 x 3 x 2 x 1 = 120</span>
      </p>

      <h3 class="text-xl font-semibold text-foreground mb-4">Silnia — Iteracyjnie</h3>
      <CodeBlock code={`public class Factorial {
    public static long factorialIteration(int n) {
        long result = 1;
        for (int i = 1; i <= n; i++) {
            result *= i;
        }
        return result;
    }
}`} lang="java" />

      <h3 class="text-xl font-semibold text-foreground mb-4 mt-8">Silnia — Rekurencyjnie</h3>
      <CodeBlock code={`public class Factorial {
    public static long factorialRecursion(int n) {
        if (n <= 1) return 1;
        return n * factorialRecursion(n - 1);
    }
}`} lang="java" />

      <InfoBox borderColor="border-primary/30 bg-primary/5" className="mt-6">
        <p className="text-foreground">
          <strong className="text-primary">Wynik:</strong> factorial(5) = 120
        </p>
      </InfoBox>
    </Section>

    <!-- 6. Zalety, Wady i Ograniczenia -->
    <Section title="6. Zalety, Wady i Ograniczenia" titleColor="text-pink-500">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b-2 border-border bg-muted/50">
              <th class="p-4 text-lg font-bold text-foreground">Cecha</th>
              <th class="p-4 text-lg font-bold text-primary">Iteracja</th>
              <th class="p-4 text-lg font-bold text-purple-500">Rekurencja</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-border border-l-4 border-l-green-500">
              <td class="p-4 text-muted-foreground font-medium">Szybkosc</td>
              <td class="p-4">
                <div class="flex items-center gap-3">
                  <RiCheckLine className="size-5 text-green-500" />
                  <span class="text-green-500">Zazwyczaj szybsza</span>
                </div>
              </td>
              <td class="p-4">
                <div class="flex items-center gap-3">
                  <RiCloseLine className="size-5 text-orange-500" />
                  <span class="text-orange-500">Zazwyczaj wolniejsza</span>
                </div>
              </td>
            </tr>
            <tr class="border-b border-border border-l-4 border-l-green-500">
              <td class="p-4 text-muted-foreground font-medium">Pamiec</td>
              <td class="p-4">
                <div class="flex items-center gap-3">
                  <RiCheckLine className="size-5 text-green-500" />
                  <span class="text-green-500">Zużywa mniej</span>
                </div>
              </td>
              <td class="p-4">
                <div class="flex items-center gap-3">
                  <RiCloseLine className="size-5 text-orange-500" />
                  <span class="text-orange-500">Zużywa wiecej</span>
                </div>
              </td>
            </tr>
            <tr class="border-b border-border border-l-4 border-l-blue-500">
              <td class="p-4 text-muted-foreground font-medium">Czytelnosc</td>
              <td class="p-4 text-muted-foreground">Dobra przy prostych zadaniach</td>
              <td class="p-4">
                <div class="flex items-center gap-3">
                  <RiCheckLine className="size-5 text-green-500" />
                  <span class="text-green-500">Czesciej bardziej elegancka</span>
                </div>
              </td>
            </tr>
            <tr class="border-b border-border border-l-4 border-l-red-500">
              <td class="p-4 text-muted-foreground font-medium">Ryzyko</td>
              <td class="p-4 text-orange-500">Nieskonczona petla</td>
              <td class="p-4 text-red-500">Stack Overflow</td>
            </tr>
            <tr class="border-b border-border border-l-4 border-l-green-500">
              <td class="p-4 text-muted-foreground font-medium">Skalowanie</td>
              <td class="p-4">
                <div class="flex items-center gap-3">
                  <RiCheckLine className="size-5 text-green-500" />
                  <span class="text-green-500">Dobrze przy duzych danych</span>
                </div>
              </td>
              <td class="p-4 text-orange-500">Problemy przy duzej glebokosci</td>
            </tr>
            <tr class="border-l-4 border-l-green-500">
              <td class="p-4 text-muted-foreground font-medium">Debugowanie</td>
              <td class="p-4">
                <div class="flex items-center gap-3">
                  <RiCheckLine className="size-5 text-green-500" />
                  <span class="text-green-500">Zwykle prostsze</span>
                </div>
              </td>
              <td class="p-4 text-orange-500">Trudniejsze przez wiele wywolan</td>
            </tr>
          </tbody>
        </table>
      </div>
    </Section>

    <!-- 7. Zalety Iteracji -->
    <Section title="7. Zalety Iteracji" titleColor="text-green-500">
      <div class="space-y-6">
        <InfoBox borderColor="border-green-500/40 bg-green-500/5">
          <div class="flex">
            <div class="w-10 flex-shrink-0">
              <RiCheckboxCircleLine className="size-7 text-green-500" />
            </div>
            <div>
              <h3 className="text-xl font-bold text-green-500 mb-3">1. Lepsza wydajnosc</h3>
              <p className="text-muted-foreground mb-3">Petle zwykle dzialaja szybciej niz rekurencja, poniewaz nie tworza nowych wywolan funkcji.</p>
              <CodeBlock code={`for (int i = 0; i < 1000; i++) {
    // szybkie powtarzanie
}`} lang="java" />
            </div>
          </div>
        </InfoBox>

        <InfoBox borderColor="border-green-500/40 bg-green-500/5">
          <div class="flex">
            <div class="w-10 flex-shrink-0">
              <RiCheckboxCircleLine className="size-7 text-green-500" />
            </div>
            <div>
              <h3 className="text-xl font-bold text-green-500 mb-3">2. Mniejsze zuzycie pamieci</h3>
              <p className="text-muted-foreground">Iteracja dziala w jednym miejscu pamieci. Nie tworzy nowych "warstw" na stosie wywolan.</p>
            </div>
          </div>
        </InfoBox>

        <InfoBox borderColor="border-green-500/40 bg-green-500/5">
          <div class="flex">
            <div class="w-10 flex-shrink-0">
              <RiCheckboxCircleLine className="size-7 text-green-500" />
            </div>
            <div>
              <h3 className="text-xl font-bold text-green-500 mb-3">3. Dobra dla duzych danych</h3>
              <p className="text-muted-foreground">Jesli trzeba przetworzyc tysiace lub miliony elementow, iteracja jest zazwyczaj bezpieczniejsza.</p>
            </div>
          </div>
        </InfoBox>
      </div>
    </Section>

    <!-- 8. Wady Iteracji -->
    <Section title="8. Wady Iteracji" titleColor="text-red-500">
      <div class="space-y-6">
        <InfoBox borderColor="border-red-500/40 bg-red-500/5">
          <div class="flex">
            <div class="w-10 flex-shrink-0">
              <RiCloseCircleLine className="size-7 text-red-500" />
            </div>
            <div>
              <h3 className="text-xl font-bold text-red-500 mb-3">1. Kod moze byc mniej czytelny</h3>
              <p className="text-muted-foreground">Przy bardzo skomplikowanych problemach wiele petli i warunkow moze stac sie trudne do zrozumienia.</p>
            </div>
          </div>
        </InfoBox>

        <InfoBox borderColor="border-red-500/40 bg-red-500/5">
          <div class="flex">
            <div class="w-10 flex-shrink-0">
              <RiCloseCircleLine className="size-7 text-red-500" />
            </div>
            <div>
              <h3 className="text-xl font-bold text-red-500 mb-3">2. Gorzej dziala przy strukturach zagniezdzonych</h3>
              <p className="text-muted-foreground">Drzewa, foldery lub HTML czesto latwiej obsluzyc rekurencja.</p>
            </div>
          </div>
        </InfoBox>
      </div>
    </Section>

    <!-- 9. Zalety Rekurencji -->
    <Section title="9. Zalety Rekurencji" titleColor="text-purple-500">
      <div class="space-y-6">
        <InfoBox borderColor="border-purple-500/40 bg-purple-500/5">
          <div class="flex">
            <div class="w-10 flex-shrink-0">
              <RiCheckboxCircleLine className="size-7 text-purple-500" />
            </div>
            <div>
              <h3 className="text-xl font-bold text-purple-500 mb-3">1. Bardziej naturalne rozwiazanie</h3>
              <p className="text-muted-foreground mb-3">Niektore problemy "same prosza sie" o rekurencje:</p>
              <ul class="list-disc list-inside text-muted-foreground ml-2 space-y-1">
                <li>drzewa</li>
                <li>foldery / system plikow</li>
                <li>grafy</li>
                <li>DOM / HTML</li>
              </ul>
            </div>
          </div>
        </InfoBox>

        <InfoBox borderColor="border-purple-500/40 bg-purple-500/5">
          <div class="flex">
            <div class="w-10 flex-shrink-0">
              <RiCheckboxCircleLine className="size-7 text-purple-500" />
            </div>
            <div>
              <h3 className="text-xl font-bold text-purple-500 mb-3">2. Krotszy i czystszy kod</h3>
              <p className="text-muted-foreground mb-3">Rekurencja czesto pozwala napisac mniej kodu.</p>
              <CodeBlock code={`public static long factorial(int n) {
    if (n <= 1) return 1;
    return n * factorial(n - 1);
}`} lang="java" />
            </div>
          </div>
        </InfoBox>

        <InfoBox borderColor="border-purple-500/40 bg-purple-500/5">
          <div class="flex">
            <div class="w-10 flex-shrink-0">
              <RiCheckboxCircleLine className="size-7 text-purple-500" />
            </div>
            <div>
              <h3 className="text-xl font-bold text-purple-500 mb-3">3. Latwiejsze myslenie o problemie</h3>
              <p className="text-muted-foreground">Problem mozna dzielic na mniejsze wersje tego samego zadania.</p>
            </div>
          </div>
        </InfoBox>
      </div>
    </Section>

    <!-- 10. Wady Rekurencji -->
    <Section title="10. Wady Rekurencji" titleColor="text-red-500">
      <div class="space-y-6">
        <InfoBox borderColor="border-red-500/40 bg-red-500/5">
          <div class="flex">
            <div class="w-10 flex-shrink-0">
              <RiCloseCircleLine className="size-7 text-red-500" />
            </div>
            <div>
              <h3 className="text-xl font-bold text-red-500 mb-3">1. Wieksze zuzycie pamieci</h3>
              <p className="text-muted-foreground">Kazde wywolanie funkcji trafia na stos wywolan. Duza liczba wywolan = wieksze zuzycie pamieci.</p>
            </div>
          </div>
        </InfoBox>

        <InfoBox borderColor="border-red-500/40 bg-red-500/5">
          <div class="flex">
            <div class="w-10 flex-shrink-0">
              <RiCloseCircleLine className="size-7 text-red-500" />
            </div>
            <div>
              <h3 className="text-xl font-bold text-red-500 mb-3">2. Ryzyko Stack Overflow</h3>
              <p className="text-muted-foreground mb-3">Jesli rekurencja jest zbyt gleboka albo nie ma poprawnego przypadku bazowego, program moze sie zatrzymac.</p>
              <p className="text-muted-foreground mb-2">Przyklad zlej rekurencji:</p>
              <CodeBlock code={`public static void badRecursion() {
    badRecursion();
}`} lang="java" />
            </div>
          </div>
        </InfoBox>

        <InfoBox borderColor="border-red-500/40 bg-red-500/5">
          <div class="flex">
            <div class="w-10 flex-shrink-0">
              <RiCloseCircleLine className="size-7 text-red-500" />
            </div>
            <div>
              <h3 className="text-xl font-bold text-red-500 mb-3">3. Wolniejsze dzialanie</h3>
              <p className="text-muted-foreground">Kazde wywolanie funkcji ma swoj koszt. Przy tysiacach wywolan moze to znaczaco spowolnic program.</p>
            </div>
          </div>
        </InfoBox>

        <InfoBox borderColor="border-red-500/40 bg-red-500/5">
          <div class="flex">
            <div class="w-10 flex-shrink-0">
              <RiCloseCircleLine className="size-7 text-red-500" />
            </div>
            <div>
              <h3 className="text-xl font-bold text-red-500 mb-3">4. Trudniejsze debugowanie</h3>
              <p className="text-muted-foreground">Sledzenie wielu wywolan funkcji moze byc trudniejsze niz analiza zwyklet petli.</p>
            </div>
          </div>
