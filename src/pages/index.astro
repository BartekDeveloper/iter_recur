              <p className="text-muted-foreground mb-3">Mozesz ograniczyc maksymalna glebokosc rekurencji:</p>
              <CodeBlock code={`static final int DEPTH_LIMIT = 10000;

public static void safeRecursion(int n, int depth) {
    if (depth > DEPTH_LIMIT) return;
    if (n <= 0) return;
    safeRecursion(n - 1, depth + 1);
}`} lang="java" />
            </div>
          </div>
        </InfoBox>

        <InfoBox borderColor="border-teal-500/40 bg-teal-500/5">
          <div class="flex">
